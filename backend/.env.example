# Get a free key at https://console.groq.com/keys (no credit card required)
# Leave blank to run in offline/template fallback mode (no LLM needed)
GROQ_API_KEY=

# Model used for question generation when GROQ_API_KEY is set
GROQ_MODEL=llama-3.1-8b-instant

# Where the SQLite database file is stored
DATABASE_URL=sqlite:///./screener.db

# Number of retrieved chunks used as context per question
RAG_TOP_K=4
